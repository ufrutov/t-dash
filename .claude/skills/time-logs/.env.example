# Copy to .env (git-ignored, chmod 600) and fill in. Never commit real values.
# Supabase project URL and anon key: same as VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY in the repo's .env
T_DASH_SUPABASE_URL=
T_DASH_SUPABASE_ANON_KEY=

# Row-level security requires your t-dash login (the account you use in the dashboard).
T_DASH_EMAIL=
T_DASH_PASSWORD=
